---
import { profile, roles, projects, orbitSkills, skillRings, education } from '../data/site';

const kindRing = { web: 0, ml: 1, systems: 2 } as const;
const kindLabel = { web: 'Web app', ml: 'Machine learning and data', systems: 'Systems and tools' } as const;
const uses = (tech: string) => projects.filter((p) => p.techs.includes(tech)).length;

// Each view fills the same orbit with a different part of the story.
const views = [
  {
    id: 'career', label: 'Career', href: '#work',
    note: `${roles.length} roles. Inner rings are the most recent, bigger means longer.`,
    items: roles.map((r, i) => ({ label: r.short ?? r.company, sub: `${r.role}, ${r.start} to ${r.end}`, ring: i, size: r.months, strong: i === 0 })),
  },
  {
    id: 'projects', label: 'Projects', href: '#projects',
    note: `${projects.length} projects. Rings group web apps, machine learning and systems.`,
    items: projects.map((p) => ({ label: p.short ?? p.title, sub: `${kindLabel[p.kind]}. ${p.techs.slice(0, 3).join(', ')}`, ring: kindRing[p.kind], size: p.featured ? 18 : 6, strong: !!p.featured })),
  },
  {
    id: 'skills', label: 'Skills', href: '#skills',
    note: 'Rings run from languages out to tools. Bigger means used in more projects.',
    items: orbitSkills.map((s) => {
      const n = uses(s.label);
      return { label: s.label, sub: n ? `${skillRings[s.ring]}, used in ${n} project${n > 1 ? 's' : ''} here` : skillRings[s.ring], ring: s.ring, size: 3 + n * 4, strong: n >= 4 };
    }),
  },
  {
    id: 'education', label: 'Education', href: '#education',
    note: 'Three schools, from Ahmedabad to Bloomington.',
    items: education.map((e, i) => ({ label: e.school, sub: `${e.degree}${e.stat ? `. GPA ${e.stat}` : ''}`, ring: i, size: 26 - i * 8, strong: i === 0 })),
  },
];
---
<section class="hero" id="top">
  <div class="copy">
    <p class="hello">Hello, my name is</p>
    <h1>{profile.name}</h1>
    <p class="sub">{profile.role} at Bolster AI. This is my world so far, from space research to security.</p>
    <div class="cta">
      <a class="btn primary" href="#work">See my work</a>
      <a class="btn ghost" href={profile.resume} target="_blank" rel="noopener">Download resume</a>
    </div>
  </div>

  <div class="stage">
    <div class="switch" role="tablist" aria-label="Choose what the orbit shows">
      {views.map((v, i) => (
        <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-view={i}>{v.label}</button>
      ))}
    </div>
    <p class="note" id="orbit-note">{views[0].note}</p>
    <canvas id="orbit" aria-label="An orbit diagram. Use the buttons above to show career, projects, skills or education. Every item is also listed further down the page."></canvas>
    <a class="card" id="orbit-card" href={views[0].href}>
      <i class="dot"></i>
      <span class="text"><b id="orbit-title"></b><span id="orbit-sub"></span></span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </a>
  </div>
  <script type="application/json" id="orbit-data" set:html={JSON.stringify(views)} />
</section>

<script>
  interface Item { label: string; sub: string; ring: number; size: number; strong: boolean; x: number; y: number; rad: number; side?: number; }
  type Box = [number, number, number, number];
  interface View { id: string; label: string; href: string; note: string; items: Item[]; rings: number; }

  const views: View[] = JSON.parse(document.getElementById('orbit-data')!.textContent!);
  views.forEach((v) => { v.rings = Math.max(...v.items.map((i) => i.ring)) + 1; });

  const root = document.documentElement;
  const cv = document.getElementById('orbit') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const card = document.getElementById('orbit-card') as HTMLAnchorElement;
  const titleEl = document.getElementById('orbit-title')!;
  const subEl = document.getElementById('orbit-sub')!;
  const noteEl = document.getElementById('orbit-note')!;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.switch button')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let W = 0, H = 0, view = views[0], active = 0, hover = -1, t = 0, grownAt = still ? -1e6 : performance.now(), last = performance.now();
  let topY = 84, botY = 0, wantTop = 84, wantBot = 0;
  let mouse: { x: number; y: number } | null = null;
  let touched = 0;
  let colors = readColors();
  const stars = Array.from({ length: 70 }, (_, i) => ({ x: (i * 0.6180339) % 1, y: (i * 0.3819660 * 7) % 1, r: 0.5 + (i % 3) * 0.4 }));

  function readColors() {
    const s = getComputedStyle(root);
    const v = (n: string) => s.getPropertyValue(n).trim();
    return { ink: v('--ink'), ring: v('--ring'), accent: v('--accent'), glow: v('--glow'), muted: v('--muted'), dark: root.dataset.theme === 'dark' };
  }
  new MutationObserver(() => { colors = readColors(); }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

  function size() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    W = cv.clientWidth; H = cv.clientHeight;
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    measure();
    topY = wantTop; botY = wantBot;
  }

  // The note and the card change height with their text, so the free space is measured, not assumed.
  function measure() {
    wantTop = noteEl.offsetTop + noteEl.offsetHeight + 6;
    wantBot = card.offsetTop - 10;
  }

  function show(i: number) {
    active = i;
    titleEl.textContent = view.items[i].label;
    subEl.textContent = view.items[i].sub;
    measure();
  }

  function setView(i: number) {
    view = views[i];
    tabs.forEach((b, j) => b.setAttribute('aria-selected', String(j === i)));
    noteEl.textContent = view.note;
    card.href = view.href;
    hover = -1; if (!still) grownAt = performance.now();
    show(0);
  }

  function frame(now: number) {
    // Queued first so one bad frame can never stop the animation.
    requestAnimationFrame(frame);
    // The script can run before the stylesheet arrives, when the colours are still empty.
    if (!colors.ink) { colors = readColors(); if (!colors.ink) return; }
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    topY += (wantTop - topY) * 0.14; botY += (wantBot - botY) * 0.14;
    if (hover < 0 && !still) t += dt;
    const ease = 1 - Math.pow(1 - Math.max(0, Math.min(1, (now - grownAt) / 700)), 3);
    const c = colors;

    ctx.clearRect(0, 0, W, H);
    // Keep the rings between the note at the top and the card at the bottom.
    const top = topY, bottom = Math.max(topY + 80, botY);
    const cx = W / 2, cy = (top + bottom) / 2;
    const maxRx = Math.min(W * 0.47, 620);
    const tilt = Math.max(0.2, Math.min(0.62, ((bottom - top) / 2 - 6) / maxRx));

    if (c.dark) {
      ctx.fillStyle = c.ink;
      for (const s of stars) { ctx.globalAlpha = 0.12 + 0.1 * Math.sin(t * 0.8 + s.x * 40); ctx.beginPath(); ctx.arc(s.x * W, s.y * H, s.r, 0, 7); ctx.fill(); }
      ctx.globalAlpha = 1;
    }
    const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, maxRx * 0.55);
    g.addColorStop(0, c.glow); g.addColorStop(1, 'transparent');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

    const perRing: number[] = [];
    view.items.forEach((s) => { perRing[s.ring] = (perRing[s.ring] || 0) + 1; });
    const seen: number[] = [];
    let near = -1, nd = 1e9;
    const wide = W > 760;

    for (let r = 0; r < view.rings; r++) {
      const rx = maxRx * (0.22 + 0.78 * (r + 1) / view.rings) * ease;
      ctx.beginPath(); ctx.ellipse(cx, cy, rx, rx * tilt, 0, 0, 7);
      ctx.strokeStyle = c.ring; ctx.lineWidth = 1; ctx.stroke();
    }
    view.items.forEach((s, i) => {
      const k = seen[s.ring] = (seen[s.ring] ?? -1) + 1;
      const rx = maxRx * (0.22 + 0.78 * (s.ring + 1) / view.rings) * ease;
      const speed = (0.2 / (1 + s.ring * 0.5)) * (s.ring % 2 ? -1 : 1);
      const a = s.ring * 1.9 + 0.5 + (k / perRing[s.ring]) * Math.PI * 2 + t * speed;
      s.x = cx + Math.cos(a) * rx; s.y = cy + Math.sin(a) * rx * tilt;
      s.rad = (wide ? 5 : 4) + Math.sqrt(s.size) * (wide ? 1.5 : 1.2);
      if (mouse) { const d = Math.hypot(mouse.x - s.x, mouse.y - s.y); if (d < s.rad + 18 && d < nd) { nd = d; near = i; } }
    });
    hover = near;
    if (near >= 0 && near !== active) show(near);
    cv.style.cursor = near >= 0 ? 'pointer' : 'default';

    ctx.beginPath(); ctx.arc(cx, cy, 9, 0, 7); ctx.fillStyle = c.ink; ctx.fill();

    const order = view.items.map((_, i) => i).sort((a, b) => view.items[a].y - view.items[b].y);
    for (const i of order) {
      const s = view.items[i], on = i === active;
      ctx.globalAlpha = ease;
      if (on) { ctx.beginPath(); ctx.arc(s.x, s.y, s.rad + 9, 0, 7); ctx.fillStyle = c.glow; ctx.fill(); }
      ctx.beginPath(); ctx.arc(s.x, s.y, s.rad, 0, 7);
      ctx.fillStyle = on ? c.accent : s.strong ? c.ink : c.muted; ctx.fill();
    }

    // Name every dot: each label takes the first free spot around its dot, most important first.
    const taken: Box[] = view.items.map((s) => [s.x - s.rad - 3, s.y - s.rad - 3, s.x + s.rad + 3, s.y + s.rad + 3]);
    taken.push([cx - 13, cy - 13, cx + 13, cy + 13], [cx - 232, bottom, cx + 232, H]);
    const rank = (i: number) => (i === active ? 2 : 0) + (view.items[i].strong ? 1 : 0);
    const byRank = view.items.map((_, i) => i).sort((a, b) => rank(b) - rank(a));
    ctx.textAlign = 'left';
    for (const i of byRank) {
      const s = view.items[i], on = i === active;
      if (!on && !wide) continue;
      ctx.font = `${on ? 600 : 400} 13px -apple-system, "Helvetica Neue", Arial, sans-serif`;
      const w = ctx.measureText(s.label).width, gap = s.rad + 8;
      const spots: Box[] = [
        [s.x + gap, s.y - 9, s.x + gap + w, s.y + 9],
        [s.x - gap - w, s.y - 9, s.x - gap, s.y + 9],
        [s.x - w / 2, s.y - s.rad - 24, s.x + w / 2, s.y - s.rad - 6],
        [s.x - w / 2, s.y + s.rad + 6, s.x + w / 2, s.y + s.rad + 24],
      ];
      // Trying the last spot first stops labels jumping around as the dots move.
      let pick = [s.side ?? 0, 0, 1, 2, 3].find((n) => {
        const b = spots[n];
        return b[0] >= 6 && b[2] <= W - 6 && b[1] >= 66 && !taken.some((o, j) => j !== i && b[0] < o[2] && b[2] > o[0] && b[1] < o[3] && b[3] > o[1]);
      });
      if (pick === undefined) { if (!on) continue; pick = s.x > W / 2 ? 1 : 0; }
      s.side = pick;
      taken.push(spots[pick]);
      ctx.globalAlpha = ease;
      ctx.fillStyle = on || s.strong ? c.ink : c.muted;
      ctx.fillText(s.label, spots[pick][0], spots[pick][1] + 13.5);
    }
    ctx.globalAlpha = 1;
  }

  function pos(e: PointerEvent) { const r = cv.getBoundingClientRect(); mouse = { x: e.clientX - r.left, y: e.clientY - r.top }; touched = performance.now(); }
  cv.addEventListener('pointermove', pos);
  cv.addEventListener('pointerdown', pos);
  cv.addEventListener('pointerleave', () => { mouse = null; });
  cv.addEventListener('pointerup', (e) => { if (e.pointerType !== 'mouse') setTimeout(() => { mouse = null; }, 60); });
  cv.addEventListener('click', () => { if (hover >= 0 && matchMedia('(hover: hover)').matches) card.click(); });
  tabs.forEach((b, i) => b.addEventListener('click', () => { touched = performance.now(); setView(i); }));
  tabs.forEach((b, i) => b.addEventListener('keydown', (e) => {
    const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
    if (d) { const n = (i + d + tabs.length) % tabs.length; tabs[n].focus(); setView(n); }
  }));
  new ResizeObserver(size).observe(cv);

  show(0); size(); requestAnimationFrame(frame);
  if (!still) setInterval(() => {
    if (hover < 0 && !mouse && performance.now() - touched > 2500) show((active + 1) % view.items.length);
  }, 2800);
</script>

<style>
  .hero { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: calc(100svh - 53px); overflow: hidden; }
  .copy { text-align: center; padding: clamp(28px, 5vh, 60px) var(--pad) 0; }
  .hello { font-size: clamp(17px, 2vw, 21px); color: var(--muted); }
  h1 { font-size: clamp(44px, 9vw, 104px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.02; margin: 6px 0 14px; }
  .sub { font-size: clamp(18px, 2.3vw, 26px); line-height: 1.4; color: var(--muted); max-width: 26em; margin: 0 auto; }
  .cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 26px; }

  .stage { position: relative; min-height: clamp(430px, 54svh, 580px); margin-top: clamp(16px, 3vh, 32px); display: flex; flex-direction: column; align-items: center; }
  .switch { position: relative; z-index: 3; display: inline-flex; padding: 3px; border-radius: 980px; background: var(--surface); border: 1px solid color-mix(in srgb, var(--line) 60%, transparent); }
  .switch button { border: 0; background: transparent; cursor: pointer; font-size: 14px; padding: 7px 16px; border-radius: 980px; color: var(--muted); transition: background 0.25s, color 0.25s; }
  .switch button[aria-selected='true'] { background: var(--bg); color: var(--ink); box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12); }
  :global([data-theme='dark']) .switch button[aria-selected='true'] { background: #2c2c31; }
  .note { position: relative; z-index: 3; font-size: 13px; color: var(--muted); margin-top: 10px; text-align: center; padding: 0 var(--pad); min-height: 2.6em; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; }
  .card {
    position: absolute; z-index: 3; left: 50%; bottom: 18px; transform: translateX(-50%); width: min(calc(100vw - 32px), 440px);
    background: color-mix(in srgb, var(--surface) 86%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line); border-radius: 18px; padding: 13px 16px 13px 18px; display: flex; align-items: center; gap: 14px; text-align: left;
    transition: border-color 0.2s;
  }
  .card:hover { border-color: var(--accent); }
  .dot { flex: none; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 6px var(--glow); }
  .text { flex: 1; min-width: 0; }
  .text b { display: block; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .text span { display: block; font-size: 14px; line-height: 1.35; color: var(--muted); }
  .card svg { flex: none; width: 18px; height: 18px; color: var(--muted); }
  @media (max-width: 480px) {
    .switch button { padding: 7px 12px; font-size: 13px; }
    /* Room for two lines, so the card keeps one height as the orbit cycles. */
    .text span { min-height: 2.7em; }
  }
</style>
